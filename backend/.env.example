# Copy to backend/.env for local dev, and set the same names in the Vercel project.
# Without SUPABASE_URL and SUPABASE_ANON_KEY the backend falls back to local SQLite.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Secret. Needed to import Rutgers marketplace listings. Never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required header value for POST /api/listings/import-external
IMPORT_ADMIN_TOKEN=any-long-random-string
# Set to false to skip the Rutgers import when the server starts
# RUTGERS_IMPORT_ON_START=true
